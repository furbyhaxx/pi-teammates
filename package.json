{
  "name": "@furbyhaxx/pi-teammates",
  "version": "0.1.0",
  "description": "Pi extension for delegating bounded work to configured teammates with isolated contexts.",
  "type": "module",
  "license": "MIT",
  "author": "furbyhaxx",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "teammates",
    "delegate",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furbyhaxx/pi-teammates.git"
  },
  "bugs": {
    "url": "https://github.com/furbyhaxx/pi-teammates/issues"
  },
  "homepage": "https://github.com/furbyhaxx/pi-teammates#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx tests/config.test.ts && tsx tests/teammates.test.ts && tsx tests/delegate.test.ts && tsx tests/process.test.ts && tsx tests/context.test.ts && tsx tests/jobs.test.ts && tsx tests/command-helpers.test.ts && tsx tests/teammate-state.test.ts && tsx tests/overlay-layout.test.ts",
    "test": "npm run typecheck && npm run test:unit",
    "build": "npm run typecheck"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.76.0",
    "@earendil-works/pi-ai": "^0.76.0",
    "@earendil-works/pi-coding-agent": "^0.76.0",
    "@earendil-works/pi-tui": "^0.76.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  }
}
